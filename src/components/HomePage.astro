---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import Hero from './Hero.astro';
import ExperienceTimeline from './ExperienceTimeline.astro';
import CaseStudies from './CaseStudies.astro';
import Publications from './Publications.astro';
import Skills from './Skills.astro';
import Ventures from './Ventures.astro';
import Education from './Education.astro';
import Contact from './Contact.astro';
import SiteFooter from './SiteFooter.astro';
import TrainingHud from './TrainingHud.astro';
import Steering from './Steering.astro';
import type { Locale } from '../content/types';
import { getCopy, getSteer, cvHref } from '../content';
import { profile } from '../content/profile';
import { buildConcepts } from '../content/concepts';
import { buildPassages } from '../content/passages';
import { retrievalByLocale } from '../content/retrieval';
import Retrieval from './Retrieval.astro';
import latent from '../data/latent.json';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getCopy(locale);
const base = import.meta.env.BASE_URL;
const cv = cvHref(locale, base);
const photoSrc = `${base}${profile.photo}`;
const title = `${profile.name} · ${t.role}`;

// Latent space built offline by scripts/embed.mjs (`npm run embed`).
type ConceptAt = { x: number; y: number; n: string[] };
const space = (latent.locales as Record<string, (typeof latent.locales)['pt'] | undefined>)[locale];
const conceptAt = (space?.concepts ?? {}) as Record<string, ConceptAt | undefined>;
const passageAt = (space?.passages ?? {}) as Record<string, { x: number; y: number } | undefined>;

const concepts = buildConcepts(t).map(({ label, cluster, section }) => {
  const at = conceptAt[label];
  return { label, cluster, section, ...(at ? { x: at.x, y: at.y, n: at.n } : {}) };
});
const passages = buildPassages(t);
const stale =
  concepts.filter((c) => !conceptAt[c.label]).length + passages.filter((p) => !passageAt[p.id]).length;
if (stale) console.warn(`[latent] ${locale}: ${stale} items have no embedding; run "npm run embed"`);
const trainData = JSON.stringify({
  concepts,
  clusters: t.train.clusters,
  clusterPos: space?.clusterPos ?? [],
  strings: t.train,
});
---

<BaseLayout locale={locale} title={title} description={t.summary}>
  <canvas class="field" aria-hidden="true"></canvas>
  <script type="application/json" id="train-data" set:html={trainData} />
  <SiteHeader
    locale={locale}
    cvHref={cv}
    ctaCv={t.ctaCv}
    langLabel={t.langLabel}
    nav={{
      experience: t.navExperience,
      cases: t.navCases,
      papers: t.navPapers,
      skills: t.navSkills,
      contact: t.navContact,
    }}
  />

  <main>
    <Hero copy={t} cvHref={cv} photoSrc={photoSrc} />
    <ExperienceTimeline label={t.experienceLabel} items={t.experience} />
    <CaseStudies copy={t} />
    <Publications
      acceptedLabel={t.pubsAcceptedLabel}
      reviewLabel={t.pubsReviewLabel}
      accepted={t.publicationsAccepted}
      review={t.publicationsReview}
    />
    <Skills label={t.skillsLabel} clusters={t.skills} />
    <Ventures label={t.openSourceLabel} items={t.openSource} id="open-source" />
    <Ventures label={t.builderLabel} items={t.ventures} />
    <Education label={t.educationLabel} items={t.education} />
    <Steering copy={getSteer(locale)} />
    <Retrieval
      copy={retrievalByLocale[locale]}
      passages={passages}
      positions={passageAt as Record<string, { x: number; y: number }>}
      vectorsHref={`${base}latent/${locale}.json`}
      model={latent.model}
    />
    <Contact copy={t} cvHref={cv} />
  </main>

  <SiteFooter
    role={t.role}
    tokens={t.tokens}
    nextLabel={t.nextTokenLabel}
    replayLabel={t.replayLabel}
  />
  <TrainingHud copy={t.train} cvHref={cv} photoSrc={photoSrc} />
</BaseLayout>
