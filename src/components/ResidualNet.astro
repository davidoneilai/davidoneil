---
interface Props {
  label: string;
  hint: string;
}

const { label, hint } = Astro.props;

const counts = [4, 6, 6, 4, 1];
const xs = [24, 102, 180, 258, 336];
const gap = 28;
const tags = ['x', 'h₁', 'h₂', 'h₃', 'ŷ'];
const dash = 14;

const layers = counts.map((n, l) =>
  Array.from({ length: n }, (_, i) => ({ x: xs[l], y: 92 - ((n - 1) * gap) / 2 + i * gap })),
);

let seed = 7;
const rand = () => {
  seed = (seed * 16807) % 2147483647;
  return (seed / 2147483647) * 2 - 1;
};

const edges = layers.slice(0, -1).flatMap((col, hop) =>
  col.flatMap((a) =>
    layers[hop + 1].map((b) => ({
      hop,
      a,
      b,
      w: rand(),
      len: Math.round(Math.hypot(b.x - a.x, b.y - a.y)),
    })),
  ),
);
const pulse = (len: number) => `stroke-dasharray:${dash} ${len};stroke-dashoffset:${dash}`;
const last = layers.length - 1;
---

<button type="button" class="net" aria-label={label}>
  <span class="net__head" aria-hidden="true">
    <span class="net__legend"><i class="net__dot net__dot--fwd"></i>forward</span>
    <span class="net__legend"><i class="net__dot net__dot--bwd"></i>backward</span>
    <span class="net__hint">{hint}</span>
  </span>
  <svg viewBox="0 0 360 198" aria-hidden="true">
    <g>
      {
        edges.map((e) => (
          <line
            class:list={['net__edge', { 'is-neg': e.w < 0 }]}
            x1={e.a.x}
            y1={e.a.y}
            x2={e.b.x}
            y2={e.b.y}
            stroke-width={(0.45 + Math.abs(e.w) * 1.6).toFixed(2)}
          />
        ))
      }
    </g>
    <g>
      {
        edges.map((e) => (
          <line
            class="net__fwd"
            data-hop={e.hop}
            data-len={e.len}
            x1={e.a.x}
            y1={e.a.y}
            x2={e.b.x}
            y2={e.b.y}
            style={pulse(e.len)}
          />
        ))
      }
    </g>
    <g>
      {
        edges.map((e) => (
          <line
            class="net__bwd"
            data-hop={e.hop}
            data-len={e.len}
            x1={e.b.x}
            y1={e.b.y}
            x2={e.a.x}
            y2={e.a.y}
            style={pulse(e.len)}
          />
        ))
      }
    </g>
    {
      layers.map((col, l) =>
        col.map((n) => (
          <circle
            class:list={['net__node', { 'net__node--out': l === last }]}
            data-layer={l}
            cx={n.x}
            cy={n.y}
            r={l === last ? 8 : 5.5}
          />
        )),
      )
    }
    {
      xs.map((x, l) => (
        <text class="net__tag" x={x} y="192" text-anchor="middle">
          {tags[l]}
        </text>
      ))
    }
  </svg>
  <span class="net__foot" aria-hidden="true">
    <span class="net__step">epoch 1 · step 00</span>
    <svg class="net__spark" viewBox="0 0 64 16"><polyline points="0,2"></polyline></svg>
    <span class="net__loss">loss 0.912</span>
  </span>
</button>
