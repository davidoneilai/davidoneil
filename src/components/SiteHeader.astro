---
import type { Locale } from '../content/types';
import { locales, localeLabels } from '../content';
import { profile } from '../content/profile';

interface Props {
  locale: Locale;
  cvHref: string;
  ctaCv: string;
  langLabel: string;
  nav: {
    experience: string;
    cases: string;
    papers: string;
    skills: string;
    contact: string;
  };
}

const { locale, cvHref, ctaCv, langLabel, nav } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href={`${base}${locale}/`}>{profile.name}</a>
    <div class="site-header__nav">
      <nav class="site-nav" aria-label="Page">
        <a href="#experience">{nav.experience}</a>
        <a href="#cases">{nav.cases}</a>
        <a href="#publications">{nav.papers}</a>
        <a href="#skills">{nav.skills}</a>
        <a href="#contact">{nav.contact}</a>
      </nav>
      <nav class="lang-switch" aria-label={langLabel}>
        {
          locales.map((l) => (
            <a href={`${base}${l}/`} aria-current={l === locale ? 'page' : undefined}>
              {localeLabels[l]}
            </a>
          ))
        }
      </nav>
      <a class="header-cv" href={cvHref} download>{ctaCv}</a>
    </div>
  </div>
</header>
