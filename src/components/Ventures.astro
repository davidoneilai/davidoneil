---
import type { LocaleCopy } from '../content/types';

interface Props {
  label: string;
  items: LocaleCopy['ventures'];
  id?: string;
}

const { label, items, id = 'ventures' } = Astro.props;
---

<section class="section section--paper" id={id}>
  <div class="wrap">
    <p class="section__label" data-denoise>{label}</p>
    <div class="ventures">
      {
        items.map((v) => (
          <article class="venture">
            <h3>{v.href ? <a href={v.href} target="_blank" rel="noreferrer">{v.name}</a> : v.name}</h3>
            <p>{v.blurb}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
